{{!< default}}
{{!--
Resources section: every post tagged "resource", routed at /resources/ by
routes.yaml (a collection with data: tag.resource, so Resources stay out of
the home feed). Image-led card grid, like Articles.
--}}

<div class="gh-page">
    <div class="gh-container">

        <header class="gh-page-head">
            <h1>Resources</h1>
            {{#tag}}
                {{#if description}}<p>{{description}}</p>{{/if}}
            {{/tag}}
        </header>

        <div class="gh-postfeed">
        {{#foreach posts}}
            {{> "card" page=../pagination.page}}
        {{/foreach}}
        </div>

        <noscript>
            <div class="gh-pagination">{{pagination}}</div>
        </noscript>

    </div>
</div>
