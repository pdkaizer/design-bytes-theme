{{!--
Site header: logo, primary navigation, theme toggle, search and the members
button. Shared by default.hbs and error.hbs.
--}}
<a class="gh-skip-link" href="#main">Skip to content</a>

<header id="gh-head" class="gh-head">
    <nav class="gh-head-inner gh-container">

        <div class="gh-head-brand">
            {{!-- Brand: the publication icon (Settings → General → Publication icon)
                 beside the site title in the heading font. The icon is
                 decorative because the title follows it. --}}
            <a class="gh-head-logo" href="{{@site.url}}">
                {{#if @site.icon}}
                    <img class="gh-head-icon{{#if @custom.dark_mode_icon}} is-light-only{{/if}}" src="{{@site.icon}}" alt="" width="48" height="48" />
                    {{!-- Optional reversed-out icon for dark mode (theme setting). --}}
                    {{#if @custom.dark_mode_icon}}
                        <img class="gh-head-icon is-dark-only" src="{{@custom.dark_mode_icon}}" alt="" width="48" height="48" />
                    {{/if}}
                {{/if}}
                <span class="gh-head-title">{{@site.title}}</span>
            </a>
            <button class="gh-burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="gh-head">
                <span class="gh-burger-box">
                    <span class="gh-burger-inner"></span>
                </span>
            </button>
        </div>
        <div class="gh-head-menu">
            {{navigation}}
        </div>
        <div class="gh-head-actions">
            <div class="gh-head-actions-list">
                {{> "theme-toggle"}}
                {{search}}
                {{#if @site.members_enabled}}
                    {{^if @member}}
                    <a class="gh-button" href="{{@site.signup_url}}">Subscribe</a>
                    {{else}}
                    <a class="gh-button" href="#/portal/account">Account</a>
                    {{/if}}
                {{/if}}
            </div>
        </div>
    </nav>
</header>
