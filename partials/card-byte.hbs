{{!--
Compact card for Bytes: text first, small thumbnail. The title link is
stretched over the whole card (see components/byte-card.css), so the link's
accessible name is just the title.
--}}
<article class="gh-byte {{post_class}}">
    <div class="gh-byte-inner">
        <div class="gh-byte-content">
            <span class="gh-byte-meta"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time></span>
            <h2 class="gh-byte-title"><a class="gh-byte-link" href="{{url}}">{{title}}</a></h2>
            <p class="gh-byte-excerpt">{{excerpt}}</p>
        </div>
        {{#if feature_image}}
            <img
                class="gh-byte-image"
                srcset="{{img_url feature_image size="xs"}} 100w, {{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w"
                sizes="(min-width: 640px) 200px, 120px"
                src="{{img_url feature_image size="s"}}"
                alt=""
                loading="lazy"
            >
        {{/if}}
    </div>
</article>
