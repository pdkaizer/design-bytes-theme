{{!--
Related posts after an article: three more posts of the same type (Byte,
Article or Resource), newest first, excluding this post. Posts without a
type tag get the three newest posts, leaving out Resources (they stay in
their own section, as on the home page). Used inside {{#post}} in post.hbs.
--}}
{{#has tag="Byte"}}
    {{#get "posts" filter="tag:byte+id:-{{id}}" limit="3" include="tags" as |related|}}
        {{> "read-next-list" posts=related title="More Bytes"}}
    {{/get}}
{{else}}
    {{#has tag="Article"}}
        {{#get "posts" filter="tag:article+id:-{{id}}" limit="3" include="tags" as |related|}}
            {{> "read-next-list" posts=related title="More articles"}}
        {{/get}}
    {{else}}
        {{#has tag="Resource"}}
            {{#get "posts" filter="tag:resource+id:-{{id}}" limit="3" include="tags" as |related|}}
                {{> "read-next-list" posts=related title="More resources"}}
            {{/get}}
        {{else}}
            {{#get "posts" filter="tag:-resource+id:-{{id}}" limit="3" include="tags" as |related|}}
                {{> "read-next-list" posts=related title="Read next"}}
            {{/get}}
        {{/has}}
    {{/has}}
{{/has}}
